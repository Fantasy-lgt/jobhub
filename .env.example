# ===== JobHub 后端环境变量样例 =====
# 复制为 .env 后按需修改；生产环境放在 server/.env

NODE_ENV=development
# 监听端口：本地默认 3000；共享主机（Phusion Passenger）会注入 PORT，此处留空即可
PORT=3000
HOST=127.0.0.1

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jobhub
DB_PASSWORD=change-me
DB_NAME=jobhub
# 部分共享主机要求 SSL 连接时设为 true
DB_SSL=false

# 鉴权（JWT_SECRET 请用 32+ 位随机串）
JWT_SECRET=please-generate-a-32-char-random-secret
# 默认用户 admin 的首次登录密码；不设置则在启动时打印一次性登录码
ADMIN_PASSWORD=change-me

# 外部程序（脚本 / AI 助手）调用业务接口用的 API Key
# 生成：openssl rand -base64 24 或 node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# 留空则禁用 API Key 鉴权通道，只允许浏览器 cookie / Bearer 登录态
JOBHUB_API_KEY=please-generate-a-random-api-key
# 可选：限制 API Key 只允许来自这些 IP（逗号分隔，留空不限制）
JOBHUB_API_KEY_ALLOW_IPS=
# 反向代理信任层数：false=不信任代理头（默认）；1=只信任一层代理（Nginx/Passenger 推荐）；>1=对应层数
TRUST_PROXY=false

# DeepSeek（AI 逐题分析；不填 Key 时自动降级为「仅机检模式」）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=60000
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_TOKENS=2000
